---
/**
 * 研究儀表板圖表（Observable Plot，客戶端渲染）
 * 色彩：單色（墨黑／次文灰）為主，強調色只用在一處（現役床位總量所在的服務型山屋）。
 * 類別識別靠直接標籤與排序，不靠多色。
 */
import type { Hut } from '../lib/data';
interface Props { huts: Hut[] }
const { huts } = Astro.props;
const rows = huts.map((h) => ({
  id: h.id, name: h.name, type: h.type, status: h.status, region: h.region,
  agency: h.agencies[0]?.name ?? '管轄不明', beds: h.beds, elev: h.elev_m,
  year: h.first_built_year ? Number(h.first_built_year) : null,
  structure: h.structure_system ?? '查無', li: h.logistics_index, li_est: h.logistics_index_estimated,
  grade: (h.grade ?? '').slice(0, 1), slug: h.slug,
}));
---
<div class="grid-2">
  <div class="chart" id="c-agency"><h3>各管理單位山屋數</h3><p class="sub">現役與歷史層合計，不含關聯設施</p><figure></figure></div>
  <div class="chart" id="c-elev"><h3>海拔分布</h3><p class="sub">每點一座；空心為歷史層。無海拔資料者不顯示</p><figure></figure></div>
  <div class="chart" id="c-year"><h3>興建年代</h3><p class="sub">以事件表首次「興建／重建」年份計；無年份者不顯示</p><figure></figure></div>
  <div class="chart" id="c-beds"><h3>床位與海拔</h3><p class="sub">現役山屋；點大小＝運補難度指數</p><figure></figure></div>
  <div class="chart" id="c-structure"><h3>結構系統</h3><p class="sub">依 Notion 欄位；多為二手來源，待覆核</p><figure></figure></div>
  <div class="chart" id="c-li"><h3>運補難度指數 1–5</h3><p class="sub">本所詮釋 v0.1；淺色＝以海拔推估</p><figure></figure></div>
</div>
<script type="application/json" id="chart-data" set:html={JSON.stringify(rows)}></script>

<script>
  import * as Plot from '@observablehq/plot';
  const rows = JSON.parse(document.getElementById('chart-data')!.textContent!);
  const INK = '#232220', SUB = '#6E6B64', HINT = '#C3BFB6', ACCENT = '#9C3D2C', LINE = '#D8D5CE';
  const base = { style: { fontFamily: 'inherit', fontSize: '12px', background: 'transparent', color: SUB }, marginLeft: 48 } as const;
  const put = (id: string, plot: Element) => { const f = document.querySelector(`#${id} figure`)!; f.replaceChildren(plot); };
  const countable = rows.filter((r: any) => r.type !== '關聯設施');
  const isHist = (r: any) => ['已停用', '已拆除', '駐在所或日治遺構', '工寮', '獵寮'].includes(r.type);
  const pad = () => { const el = document.querySelector('.chart') as HTMLElement; return parseFloat(getComputedStyle(el).paddingLeft) * 2 || 40; };
  const w = (id: string) => Math.max(240, (document.getElementById(id)!.clientWidth || 480) - pad());
  const tip = (f: (d: any) => string) => ({ title: f } as any);
  // 手機：左側標籤欄縮窄、點標籤關掉，避免互相壓字
  const narrow = () => (document.getElementById('c-agency')!.clientWidth || 480) < 420;

  function render() {
  const N = narrow();
  const H = N ? 220 : 260;
  // 1 管理單位（水平長條，排序）
  put('c-agency', Plot.plot({
    ...base, width: w('c-agency'), height: H, marginLeft: N ? 118 : 150, x: { label: '座', grid: true, tickSize: 0 }, y: { label: null, tickSize: 0 },
    marks: [
      Plot.barX(countable, Plot.groupY({ x: 'count' }, { y: (d: any) => d.agency.replace('林業及自然保育署', '林保署').replace('國家公園管理處', N ? '國家公園' : '國家公園管理處'), fill: INK, rx: 3, insetTop: 2, insetBottom: 2, sort: { y: '-x' }, ...tip((d: any) => d.agency) })),
      Plot.textX(countable, Plot.groupY({ x: 'count', text: 'count' }, { y: (d: any) => d.agency.replace('林業及自然保育署', '林保署').replace('國家公園管理處', N ? '國家公園' : '國家公園管理處'), dx: 6, textAnchor: 'start', fill: SUB, fontFamily: 'JetBrains Mono' })),
      Plot.ruleX([0], { stroke: LINE }),
    ],
  }));

  // 2 海拔分布（strip）
  const withElev = countable.filter((r: any) => r.elev != null);
  put('c-elev', Plot.plot({
    ...base, width: w('c-elev'), height: H, marginLeft: N ? 70 : 110, x: { label: '海拔 m', grid: true, domain: [800, 3800], tickSize: 0 }, y: { label: null, tickSize: 0 },
    marks: [
      Plot.dot(withElev, { x: 'elev', y: 'region', r: N ? 4 : 5, fill: (d: any) => isHist(d) ? '#FFFFFF' : INK, stroke: (d: any) => isHist(d) ? SUB : '#FFFFFF', strokeWidth: 1, ...tip((d: any) => `${d.name}\n${d.elev} m・${d.type}`) }),
      Plot.ruleX([3000], { stroke: HINT, strokeDasharray: '3,3' }),
      Plot.text([{ x: 3000, y: '林保署' }], { x: 'x', y: 'y', text: () => '3,000 m', dy: -14, fill: SUB, fontSize: 11 }),
    ],
  }));

  // 3 興建年代（十年為一格）
  const withYear = countable.filter((r: any) => r.year);
  put('c-year', Plot.plot({
    ...base, width: w('c-year'), height: H, x: { label: '年代', tickFormat: (d: number) => `${d}s`, tickSize: 0 }, y: { label: '座', grid: true, tickSize: 0 },
    marks: [
      Plot.rectY(withYear, Plot.binX({ y: 'count' }, { x: 'year', thresholds: (d3range(1910, 2040, 10) as any), fill: INK, rx: 3, inset: 1, ...tip((d: any) => d.name) })),
      Plot.ruleY([0], { stroke: LINE }),
    ],
  }));
  function d3range(a: number, b: number, s: number) { const o = []; for (let i = a; i < b; i += s) o.push(i); return o; }

  // 4 床位 × 海拔（現役）
  const current = countable.filter((r: any) => !isHist(r) && r.elev != null && r.beds != null);
  put('c-beds', Plot.plot({
    ...base, width: w('c-beds'), height: H, x: { label: '海拔 m', grid: true, tickSize: 0 }, y: { label: '核定床位', grid: true, tickSize: 0 }, r: { range: [3, 9] },
    marks: [
      Plot.dot(current, { x: 'elev', y: 'beds', r: (d: any) => d.li ?? 2, fill: (d: any) => d.type === '服務型山屋' ? ACCENT : INK, fillOpacity: 0.85, stroke: '#FFFFFF', strokeWidth: 1, ...tip((d: any) => `${d.name}\n${d.beds} 床・${d.elev} m・運補 ${d.li ?? '—'}`) }),
      Plot.text(current.filter((d: any) => d.beds >= (N ? 100 : 60)), { x: 'elev', y: 'beds', text: 'name', dy: -11, fill: SUB, fontSize: 11 }),
    ],
  }));

  // 5 結構系統
  put('c-structure', Plot.plot({
    ...base, width: w('c-structure'), height: H, marginLeft: N ? 100 : 120, x: { label: '座', grid: true, tickSize: 0 }, y: { label: null, tickSize: 0 },
    marks: [
      Plot.barX(countable, Plot.groupY({ x: 'count' }, { y: 'structure', fill: (d: any) => d.structure === '查無' ? HINT : INK, rx: 3, insetTop: 2, insetBottom: 2, sort: { y: '-x' } })),
      Plot.textX(countable, Plot.groupY({ x: 'count', text: 'count' }, { y: 'structure', dx: 6, textAnchor: 'start', fill: SUB, fontFamily: 'JetBrains Mono' })),
      Plot.ruleX([0], { stroke: LINE }),
    ],
  }));

  // 6 運補難度指數（堆疊：實算／推估）
  const withLi = countable.filter((r: any) => r.li != null);
  put('c-li', Plot.plot({
    ...base, width: w('c-li'), height: H, x: { label: '指數', tickSize: 0 }, y: { label: '座', grid: true, tickSize: 0 },
    marks: [
      Plot.barY(withLi, Plot.groupX({ y: 'count' }, { x: 'li', fill: (d: any) => d.li_est ? HINT : INK, rx: 3, inset: 6, order: (d: any) => d.li_est ? 1 : 0 })),
      Plot.textY(withLi, Plot.groupX({ y: 'count', text: 'count' }, { x: 'li', dy: -8, fill: SUB, fontFamily: 'JetBrains Mono' })),
      Plot.ruleY([0], { stroke: LINE }),
    ],
  }));
  }

  render();
  // 轉向或視窗縮放時重畫（寬度變化 >24px 才動，避免捲動列造成抖動）
  let lastW = w('c-agency'), t: number | undefined;
  addEventListener('resize', () => { clearTimeout(t); t = setTimeout(() => { const nw = w('c-agency'); if (Math.abs(nw - lastW) > 24) { lastW = nw; render(); } }, 150) as unknown as number; });
</script>
