---
/**
 * 3D 地形圖（MapLibre GL JS）
 * 底圖：國土測繪中心通用版電子地圖 EMAP5_OPENDATA（政府資料開放授權第 1 版）
 * 地形：OsmHackTW terrain-rgb（內政部 20 m DEM，z≤13；原型期暫用，Phase 2 改自製圖磚放 Cloudflare R2）
 */
interface Props {
  features: GeoJSON.FeatureCollection;
  center?: [number, number];
  zoom?: number;
  pitch?: number;
  class?: string;
  id?: string;
  focus?: string; // 單座山屋頁：高亮此 TWH ID
  views?: boolean; // 主地圖：顯示國家公園快速視角按鈕
}
import { readFileSync } from 'node:fs';
import { huts as publishedHuts, trails as allTrails } from '../lib/data';
const { features, center = [121.0, 23.6], zoom = 7.3, pitch = 45, class: cls = '', id = 'map', focus, views = false } = Astro.props;
// 經典路線選單與介紹卡：build 時從路線檔撈出「經典縱走」，算好外框、全長、沿線山峰與登山口。
// 同一路線可能分散在官方與 OSM 兩檔（例如嘉明湖的延伸段）。簡介與沿線山屋來自 Notion（trails.json、huts.json）
type Classic = { id: string; name: string; en: string | null; summary: string | null; ref: { days: string | null; difficulty: string | null; distance: string | null; url: string; checked: string | null } | null; bb: number[]; km: number; sources: string[]; trailheads: string[]; peaks: { name: string; ele: number }[]; huts: { name: string; slug: string }[] };
const CLASSIC: Classic[] = (() => {
  if (!Astro.props.views) return [];
  const R = 6371008.8, rad = Math.PI / 180;
  const dist = (a: number[], b: number[]) => { const h = Math.sin((b[1] - a[1]) * rad / 2) ** 2 + Math.cos(a[1] * rad) * Math.cos(b[1] * rad) * Math.sin((b[0] - a[0]) * rad / 2) ** 2; return 2 * R * Math.asin(Math.sqrt(h)); };
  const read = (f: string) => { try { return JSON.parse(readFileSync(`data/${f}`, 'utf8')); } catch { return { features: [] }; } };
  const peaks = read('peaks.geojson').features;
  const byId = new Map<string, Classic & { pts: number[][] }>();
  for (const f of ['official', 'osm']) for (const x of read(`routes.${f}.geojson`).features) {
    const p = x.properties;
    if (p.kind === 'route' && p.category === '經典縱走') {
      const t = allTrails.find((y: any) => y.id === p.trail_id) as any;
      const e = byId.get(p.trail_id) ?? { id: p.trail_id, name: p.trail, en: p.trail_en ?? null, summary: t?.summary ?? null, ref: t?.ref ?? null, bb: [180, 90, -180, -90], km: 0, sources: [], trailheads: [], peaks: [], huts: [], pts: [] };
      for (const l of x.geometry.type === 'LineString' ? [x.geometry.coordinates] : x.geometry.coordinates) {
        for (let i = 0; i < l.length; i++) { const [lon, lat] = l[i]; e.bb = [Math.min(e.bb[0], lon), Math.min(e.bb[1], lat), Math.max(e.bb[2], lon), Math.max(e.bb[3], lat)]; if (i) e.km += dist(l[i - 1], l[i]) / 1000; e.pts.push(l[i]); }
      }
      if (!e.sources.includes(p.source)) e.sources.push(p.source);
      byId.set(p.trail_id, e);
    }
  }
  for (const f of ['osm']) for (const x of read(`routes.${f}.geojson`).features) {
    const e = byId.get(x.properties.trail_id); if (e && x.properties.kind === 'trailhead') e.trailheads.push(x.properties.name);
  }
  for (const e of byId.values()) {
    e.peaks = peaks.filter((pk: any) => e.pts.some((q) => dist(q, pk.geometry.coordinates) < 500)).map((pk: any) => ({ name: pk.properties.name, ele: pk.properties.ele })).sort((a: any, b: any) => b.ele - a.ele);
    e.huts = publishedHuts.filter((h) => h.trails.some((t: any) => t.id === e.id) && h.type !== '關聯設施').map((h) => ({ name: h.name, slug: h.slug }));
  }
  return [...byId.values()].map(({ pts, ...e }) => ({ ...e, km: Math.round(e.km) })).sort((a, b) => a.name.localeCompare(b.name, 'zh-Hant-TW'));
})();
// 快速視角：範圍取自 data/parks.geojson 的外框（2026-10-11 計算），bearing 依主稜走向微轉，讓 3D 地形側光好讀
const VIEWS = [
  { key: 'island', label: '全島', center, zoom, pitch, bearing: 0 },
  { key: 'yushan', label: '玉山', bounds: [120.825, 23.223, 121.25, 23.577], pitch: 55, bearing: 15 },
  { key: 'sheipa', label: '雪霸', bounds: [120.997, 24.249, 121.342, 24.53], pitch: 55, bearing: -25 },
  { key: 'taroko', label: '太魯閣', bounds: [121.234, 24.042, 121.716, 24.384], pitch: 55, bearing: 20 },
];
const base = import.meta.env.BASE_URL;
// 色彩依品牌規範：單一強調色給「現役山屋」；歷史層以空心圈（次文色）區別；關聯設施淡化。
// 類別差異另以形狀（實心／空心）與大小（床位）承載，不只靠顏色。
const CLASS_OF = (t: string) => ['已停用', '已拆除', '駐在所或日治遺構', '工寮', '獵寮'].includes(t) ? 'historic' : t === '關聯設施' ? 'related' : 'current';
const CLASS_COLOR: Record<string, string> = { current: '#9C3D2C', historic: '#6E6B64', related: '#9A968D' };
const CLASS_LABEL: Record<string, string> = { current: '現役山屋（實心；大小＝核定床位）', historic: '歷史層：停用、已拆除、遺構、工寮（空心）', related: '關聯設施（不計入統計）' };
for (const f of features.features) (f.properties as any).cls = CLASS_OF((f.properties as any).type);
---
{views && (
  <nav class="map-views" data-for={id} aria-label="國家公園快速視角">
    {VIEWS.map((v, i) => <button type="button" data-view={JSON.stringify(v)} aria-pressed={i === 0 ? 'true' : 'false'}>{v.label}</button>)}
    {CLASSIC.length > 0 && (
      <label class="map-classic">
        <span>經典路線</span>
        <select>
          <option value="">— 選擇路線 —</option>
          {CLASSIC.map((c) => <option value={c.id} data-bb={JSON.stringify(c.bb)}>{c.name}</option>)}
        </select>
      </label>
    )}
  </nav>
)}
<div class="map-wrap">
<div id={id} data-views={views ? '1' : ''} class:list={['map', cls]} data-features={JSON.stringify(features)} data-center={JSON.stringify(center)} data-zoom={zoom} data-pitch={pitch} data-base={base} data-focus={focus ?? ''} data-colors={JSON.stringify(CLASS_COLOR)}></div>
{CLASSIC.map((c) => (
  <aside class="classic-card" data-for={id} data-trail={c.id} hidden aria-live="polite">
    <button type="button" class="classic-close" aria-label="關閉路線介紹">×</button>
    <p class="classic-tag">經典縱走・AI 初稿待覆核</p>
    <h3>{c.name}</h3>
    {c.en && <p class="classic-en">{c.en}</p>}
    {c.summary && <p class="classic-summary">{c.summary}</p>}
    <dl>
      {c.ref && <><dt>參考天數</dt><dd>{c.ref.days ?? '—'}</dd><dt>參考難度</dt><dd>{c.ref.difficulty ?? '—'}</dd><dt>參考里程</dt><dd>{c.ref.distance ?? '—'}</dd>
        <dt></dt><dd class="muted classic-ref">出處：<a href={c.ref.url} target="_blank" rel="noopener">健行筆記</a>（山友社群整理，非官方；查證 {c.ref.checked}）</dd></>}
      <dt>地圖線長</dt><dd>約 {c.km} km<span class="muted">（依地圖線段計算）</span></dd>
      {c.huts.length > 0 && <><dt>沿線山屋</dt><dd>{c.huts.map((h, i) => <>{i > 0 && '、'}<a href={`${base}huts/${h.slug}/`}>{h.name}</a></>)}</dd></>}
      {c.peaks.length > 0 && <><dt>主要山峰</dt><dd>{c.peaks.map((p) => `${p.name} ${p.ele.toLocaleString('zh-Hant-TW')} m`).join('、')}</dd></>}
      {c.trailheads.length > 0 && <><dt>登山口</dt><dd>{c.trailheads.join('、')}</dd></>}
      <dt>路線來源</dt><dd class="muted">{c.sources.join('；')}</dd>
    </dl>
    <p class="classic-note">路線為示意，不可作為導航。入山前請查各管理單位最新公告。</p>
  </aside>
))}
</div>
<div class="map-legend" aria-hidden="true">
  {Object.entries(CLASS_COLOR).filter(([k]) => features.features.some((f) => (f.properties as any)?.cls === k)).map(([k, c]) => <span style={`--c:${c}`}>{CLASS_LABEL[k]}</span>)}
  <span style="--c:transparent">外圈＝座標已降階至 1 km 網格</span>
  <span class="park">虛線＝國家公園計畫範圍（玉山、太魯閣、雪霸）</span>
  <span class="route">黑實線＝主要登山路線（示意，不可作為導航）</span>
  <span class="access">灰實線＝登山口至主要道路</span>
  <span class="trailhead">白點＝登山口</span>
  <span class="hq">黑點＝國家公園管理處</span>
  {views && <span class="peak">三角＝主要山峰與標高（隨視角切換）</span>}
</div>

<script>
  import * as maplibregl from 'maplibre-gl';
  import 'maplibre-gl/dist/maplibre-gl.css';
  // MapLibre 6 以 import.meta.url 推導 worker 路徑，經 Vite 打包會失效；改由 Vite 打包 worker 並指定 URL
  import workerUrl from 'maplibre-gl/dist/maplibre-gl-worker.mjs?worker&url';
  maplibregl.setWorkerUrl(workerUrl);

  // 觸控裝置：沒有 hover，點一下先看資訊、再點一次進詳頁；內嵌地圖用雙指操作，單指留給頁面捲動
  const TOUCH = matchMedia('(hover: none) and (pointer: coarse)').matches;
  const NARROW = matchMedia('(max-width: 640px)').matches;

  for (const el of document.querySelectorAll<HTMLElement>('.map[data-features]')) {
    const features = JSON.parse(el.dataset.features!);
    const colors = JSON.parse(el.dataset.colors!);
    const base = el.dataset.base!;
    const focus = el.dataset.focus;
    const colorExpr: any = ['match', ['get', 'cls'], ...Object.entries(colors).flat(), '#9A968D'];
    const isCurrent: any = ['==', ['get', 'cls'], 'current'];
    const embedded = !el.classList.contains('tall');

    const map = new maplibregl.Map({
      container: el,
      center: JSON.parse(el.dataset.center!),
      zoom: Number(el.dataset.zoom) - (NARROW && !focus ? 0.6 : 0), // 手機畫面窄，整島要退一級才看得全
      pitch: Number(el.dataset.pitch),
      maxPitch: 70,
      maxZoom: 15,
      cooperativeGestures: TOUCH && embedded,
      locale: { 'CooperativeGesturesHandler.MobileHelpText': '用雙指移動地圖', 'CooperativeGesturesHandler.MacHelpText': '按住 ⌘ 加滾輪縮放', 'CooperativeGesturesHandler.WindowsHelpText': '按住 Ctrl 加滾輪縮放' },
      attributionControl: false,
      style: {
        version: 8,
        glyphs: 'https://demotiles.maplibre.org/font/{fontstack}/{range}.pbf',
        sources: {
          emap: {
            type: 'raster', tileSize: 256, maxzoom: 18,
            tiles: ['https://wmts.nlsc.gov.tw/wmts/EMAP5_OPENDATA/default/GoogleMapsCompatible/{z}/{y}/{x}'],
            attribution: '底圖 © 國土測繪中心 通用版電子地圖（政府資料開放授權）',
          },
          dem: {
            type: 'raster-dem', tileSize: 256, maxzoom: 13, encoding: 'mapbox',
            tiles: ['https://osmhacktw.github.io/terrain-rgb/tiles/{z}/{x}/{y}.png'],
            attribution: '地形 內政部 20 m DEM／OsmHackTW terrain-rgb',
          },
          huts: { type: 'geojson', data: features },
          // 國家公園範圍約 70 KB，以 URL 交給 worker 抓，不內嵌進每一頁
          parks: { type: 'geojson', data: new URL(`${base}data/parks.geojson`, location.href).href, attribution: '國家公園範圍 © 內政部國家公園署（政府資料開放授權）' },
          // 路線分兩檔：官方開放資料（政府資料開放授權）與 OSM 衍生（ODbL），授權不同不混檔
          routesGov: { type: 'geojson', data: new URL(`${base}data/routes.official.geojson`, location.href).href, attribution: '登山路線 雪霸國家公園管理處、林業及自然保育署（政府資料開放授權）' },
          hq: { type: 'geojson', data: new URL(`${base}data/park-hq.geojson`, location.href).href, attribution: '管理處位置 © OpenStreetMap contributors（ODbL）' },
          ...(el.dataset.views ? { peaks: { type: 'geojson' as const, data: new URL(`${base}data/peaks.geojson`, location.href).href, attribution: '山峰位置與標高 © OpenStreetMap contributors（ODbL）' } } : {}),
          routesOsm: { type: 'geojson', data: new URL(`${base}data/routes.osm.geojson`, location.href).href, attribution: '登山路線、登山口、道路 © OpenStreetMap contributors（ODbL）' },
        },
        terrain: { source: 'dem', exaggeration: 1.3 },
        layers: [
          { id: 'emap', type: 'raster', source: 'emap', paint: { 'raster-saturation': -0.35, 'raster-brightness-max': 0.95 } },
          { id: 'hillshade', type: 'hillshade', source: 'dem', paint: { 'hillshade-exaggeration': 0.35, 'hillshade-shadow-color': '#6E6B64', 'hillshade-highlight-color': '#FFFFFF', 'hillshade-accent-color': '#C3BFB6' } },
          // 國家公園範圍：灰階虛線＋極淡填色，墊在山屋點下方；不另配色（品牌只允許單一強調色）
          { id: 'park-fill', type: 'fill', source: 'parks', paint: { 'fill-color': '#6E6B64', 'fill-opacity': 0.1 } },
          // 地形暈渲很花，虛線底下墊一道白邊才讀得出來
          { id: 'park-casing', type: 'line', source: 'parks', paint: { 'line-color': '#FFFFFF', 'line-width': ['interpolate', ['linear'], ['zoom'], 7, 3.5, 12, 5], 'line-opacity': 0.8 } },
          { id: 'park-line', type: 'line', source: 'parks', paint: { 'line-color': '#6E6B64', 'line-width': ['interpolate', ['linear'], ['zoom'], 7, 1.5, 12, 2.5], 'line-dasharray': [3, 2] } },
          // 路線：同樣墊白邊；登山路線用墨色實線，接駁道路用次文色，皆不另配色
          ...(['routesGov', 'routesOsm'] as const).flatMap((src) => [
            { id: `${src}-casing`, type: 'line' as const, source: src, filter: ['in', ['get', 'kind'], ['literal', ['route', 'access']]] as any, layout: { 'line-join': 'round' as const, 'line-cap': 'round' as const },
              paint: { 'line-color': '#FFFFFF', 'line-width': ['interpolate', ['linear'], ['zoom'], 7, 2.5, 13, 5] as any, 'line-opacity': 0.75 } },
            { id: `${src}-access`, type: 'line' as const, source: src, filter: ['==', ['get', 'kind'], 'access'] as any, layout: { 'line-join': 'round' as const, 'line-cap': 'round' as const },
              paint: { 'line-color': '#6E6B64', 'line-width': ['interpolate', ['linear'], ['zoom'], 7, 1, 13, 2.5] as any } },
            { id: `${src}-route`, type: 'line' as const, source: src, filter: ['==', ['get', 'kind'], 'route'] as any, layout: { 'line-join': 'round' as const, 'line-cap': 'round' as const },
              paint: { 'line-color': '#232220', 'line-width': ['interpolate', ['linear'], ['zoom'], 7, 1, 13, 2.5] as any } },
          ]),
          // 經典路線高亮：選單選了才出現，用唯一的強調色
          ...(['routesGov', 'routesOsm'] as const).flatMap((src) => [
            { id: `${src}-hl-casing`, type: 'line' as const, source: src, filter: ['==', ['get', 'trail_id'], '__none__'] as any, layout: { 'line-join': 'round' as const, 'line-cap': 'round' as const },
              paint: { 'line-color': '#FFFFFF', 'line-width': ['interpolate', ['linear'], ['zoom'], 7, 5, 13, 9] as any } },
            { id: `${src}-hl`, type: 'line' as const, source: src, filter: ['==', ['get', 'trail_id'], '__none__'] as any, layout: { 'line-join': 'round' as const, 'line-cap': 'round' as const },
              paint: { 'line-color': '#9C3D2C', 'line-width': ['interpolate', ['linear'], ['zoom'], 7, 2.5, 13, 5] as any } },
          ]),
          // 行進方向箭頭：只畫在「行進線」（kind=flow），選了經典路線才出現
          ...(['routesGov', 'routesOsm'] as const).map((src) => ({ id: `${src}-flow`, type: 'symbol' as const, source: src, filter: ['all', ['==', ['get', 'kind'], 'flow'], ['==', ['get', 'trail_id'], '__none__']] as any,
            layout: { 'symbol-placement': 'line' as const, 'symbol-spacing': 45, 'icon-image': 'flow-arrow', 'icon-size': ['interpolate', ['linear'], ['zoom'], 8, 1, 13, 1.4] as any,
              'icon-allow-overlap': true, 'icon-ignore-placement': true, 'icon-rotation-alignment': 'map' as const, 'icon-pitch-alignment': 'map' as const } })),
          { id: 'trailhead', type: 'circle', source: 'routesOsm', filter: ['==', ['get', 'kind'], 'trailhead'], minzoom: 8.5,
            paint: { 'circle-radius': 3.5, 'circle-color': '#FFFFFF', 'circle-stroke-width': 1.5, 'circle-stroke-color': '#232220' } },
          { id: 'trailhead-label', type: 'symbol', source: 'routesOsm', filter: ['==', ['get', 'kind'], 'trailhead'], minzoom: 10.5,
            layout: { 'text-field': ['get', 'name'], 'text-size': 11, 'text-offset': [0, -1.1], 'text-anchor': 'bottom', 'text-font': ['Noto Sans Regular'] },
            paint: { 'text-color': '#6E6B64', 'text-halo-color': '#FFFFFF', 'text-halo-width': 1.2 } },
          { id: 'park-label', type: 'symbol', source: 'parks', maxzoom: 11,
            layout: { 'text-field': ['get', 'name'], 'text-size': 13, 'text-font': ['Noto Sans Regular'], 'text-letter-spacing': 0.15 },
            paint: { 'text-color': '#6E6B64', 'text-halo-color': '#FFFFFF', 'text-halo-width': 1.4 } },
          // 主要山峰：只在有快速視角的地圖出現，依所選視角切換（初始為全島五嶽＋大霸）
          ...(el.dataset.views ? [{ id: 'peak', type: 'symbol' as const, source: 'peaks', filter: ['in', ',island,', ['get', 'views']] as any,
            layout: { 'icon-image': 'peak', 'icon-size': 1, 'icon-allow-overlap': true, 'text-field': ['format', ['get', 'name'], {}, '\n', {}, ['concat', ['to-string', ['get', 'ele']], ' m'], { 'font-scale': 0.85 }] as any,
              'text-size': 12, 'text-font': ['Noto Sans Regular'], 'text-anchor': 'top' as const, 'text-offset': [0, 0.7], 'text-optional': true },
            paint: { 'text-color': '#232220', 'text-halo-color': '#FFFFFF', 'text-halo-width': 1.4 } }] : []),
          { id: 'hq', type: 'circle', source: 'hq',
            paint: { 'circle-radius': 5, 'circle-color': '#232220', 'circle-stroke-width': 2, 'circle-stroke-color': '#FFFFFF' } },
          { id: 'hq-label', type: 'symbol', source: 'hq', minzoom: 7,
            layout: { 'text-field': ['get', 'name'], 'text-size': 12, 'text-offset': [0, 1.1], 'text-anchor': 'top', 'text-font': ['Noto Sans Regular'] },
            paint: { 'text-color': '#232220', 'text-halo-color': '#FFFFFF', 'text-halo-width': 1.4 } },
          { id: 'hut-pts', type: 'circle', source: 'huts', paint: {
              'circle-radius': ['interpolate', ['linear'], ['coalesce', ['get', 'beds'], 0], 0, 5, 20, 7, 60, 10, 140, 14],
              'circle-color': ['case', isCurrent, colorExpr, 'rgba(255,255,255,0.75)'],
              'circle-opacity': 0.92,
              'circle-stroke-width': ['case', isCurrent, 1, 2],
              'circle-stroke-color': ['case', isCurrent, '#FFFFFF', colorExpr],
          } },
          // 透明命中層：手指點得到（半徑 18px ≈ 44px 觸控目標），不影響視覺
          { id: 'hut-hit', type: 'circle', source: 'huts', paint: { 'circle-radius': TOUCH ? 18 : 9, 'circle-color': 'transparent', 'circle-opacity': 0 } },
          { id: 'hut-grid', type: 'circle', source: 'huts', filter: ['!=', ['get', 'coord_rule'], '完整公開'],
            paint: { 'circle-radius': 13, 'circle-color': 'transparent', 'circle-stroke-width': 1, 'circle-stroke-color': '#9A968D', 'circle-stroke-opacity': 0.9 } },
          { id: 'hut-focus', type: 'circle', source: 'huts', filter: ['==', ['get', 'id'], focus || '__none__'],
            paint: { 'circle-radius': 18, 'circle-color': 'transparent', 'circle-stroke-width': 1.5, 'circle-stroke-color': '#232220' } },
          { id: 'hut-label', type: 'symbol', source: 'huts', minzoom: 9,
            layout: { 'text-field': ['get', 'name'], 'text-size': 12, 'text-offset': [0, 1.2], 'text-anchor': 'top', 'text-font': ['Noto Sans Regular'] },
            paint: { 'text-color': '#232220', 'text-halo-color': '#FFFFFF', 'text-halo-width': 1.2 } },
        ],
      },
    });
    // 山峰三角形圖示：執行時畫，墨色填色＋白邊，不另加色彩
    map.on('styleimagemissing', (e) => {
      if (e.id !== 'peak' || map.hasImage('peak')) return;
      const r = 2, w = 14 * r, h = 12 * r, c = document.createElement('canvas'); c.width = w; c.height = h;
      const g = c.getContext('2d')!; g.beginPath(); g.moveTo(w / 2, r * 1.5); g.lineTo(w - r * 1.5, h - r * 1.5); g.lineTo(r * 1.5, h - r * 1.5); g.closePath();
      g.fillStyle = '#232220'; g.strokeStyle = '#FFFFFF'; g.lineWidth = r * 1.5; g.lineJoin = 'round'; g.stroke(); g.fill();
      map.addImage('peak', g.getImageData(0, 0, w, h), { pixelRatio: r });
    });
    // 行進方向箭頭：白色 V 形，墨色細邊；圖示朝右，沿線放置時 MapLibre 會轉向行進方向
    map.on('styleimagemissing', (e) => {
      if (e.id !== 'flow-arrow' || map.hasImage('flow-arrow')) return;
      const r = 2, w = 12 * r, h = 12 * r, c = document.createElement('canvas'); c.width = w; c.height = h;
      const g = c.getContext('2d')!; g.lineCap = 'round'; g.lineJoin = 'round';
      const path = () => { g.beginPath(); g.moveTo(3.5 * r, 2.5 * r); g.lineTo(8.5 * r, 6 * r); g.lineTo(3.5 * r, 9.5 * r); };
      path(); g.strokeStyle = '#232220'; g.lineWidth = 4.2 * r; g.stroke();
      path(); g.strokeStyle = '#FFFFFF'; g.lineWidth = 2.2 * r; g.stroke();
      map.addImage('flow-arrow', g.getImageData(0, 0, w, h), { pixelRatio: r });
    });
    map.addControl(new maplibregl.NavigationControl({ visualizePitch: true }), 'top-right');
    map.addControl(new maplibregl.TerrainControl({ source: 'dem', exaggeration: 1.3 }), 'top-right');
    map.addControl(new maplibregl.ScaleControl({ unit: 'metric' }), 'bottom-left');
    map.addControl(new maplibregl.AttributionControl({ compact: true }), 'bottom-right');
    // 出處預設收合（按 ⓘ 可展開）：圖資來源已有七項，展開會蓋掉半張地圖。
    // MapLibre 每載入一個新來源會重新展開，所以持續收合，直到使用者自己按 ⓘ
    const attrib = el.querySelector('.maplibregl-ctrl-attrib');
    if (attrib) {
      let userOpened = false;
      attrib.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('.maplibregl-ctrl-attrib-button')) userOpened = true; });
      const collapse = () => { if (!userOpened && attrib.classList.contains('maplibregl-compact-show')) attrib.classList.remove('maplibregl-compact-show'); };
      new MutationObserver(collapse).observe(attrib, { attributes: true, attributeFilter: ['class'] });
      collapse();
    }


    const html = (p: any) =>
      `<b>${p.name}</b>${p.name_en ? `<br><span style="color:#6E6B64">${p.name_en}</span>` : ''}<br>${p.type}・${p.elev_m ?? '—'} m・${p.beds ?? '—'} 床<br>` +
      `<span style="color:#6E6B64">${p.id}・查證 ${String(p.grade ?? '').slice(0, 1)}${p.coord_rule !== '完整公開' ? '・座標降階' : ''}</span>` +
      (TOUCH ? `<a class="go" href="${base}huts/${p.slug}/">查看詳頁 →</a>` : '');
    const popup = new maplibregl.Popup({ closeButton: TOUCH, closeOnClick: TOUCH, offset: TOUCH ? 14 : 10, maxWidth: '260px' });

    if (!TOUCH) {
      map.on('mouseenter', 'hut-hit', (e) => {
        map.getCanvas().style.cursor = 'pointer';
        const f = e.features![0];
        popup.setLngLat((f.geometry as any).coordinates.slice()).setHTML(html(f.properties)).addTo(map);
      });
      map.on('mouseleave', 'hut-hit', () => { map.getCanvas().style.cursor = ''; popup.remove(); });
      map.on('click', 'hut-hit', (e) => { const p = e.features![0].properties as any; location.href = `${base}huts/${p.slug}/`; });
    } else {
      // 第一次點：顯示資訊卡；再點同一座：進詳頁
      let shown: string | null = null;
      map.on('click', 'hut-hit', (e) => {
        const f = e.features![0]; const p = f.properties as any;
        if (shown === p.id) { location.href = `${base}huts/${p.slug}/`; return; }
        shown = p.id;
        popup.setLngLat((f.geometry as any).coordinates.slice()).setHTML(html(p)).addTo(map);
        map.easeTo({ center: (f.geometry as any).coordinates, duration: 350 });
      });
      popup.on('close', () => { shown = null; });
    }

    // 山峰依目前視角篩選；樣式還沒載好時先記住，載好再補套
    let viewKey = 'island';
    const applyPeaks = () => { if (map.getLayer('peak')) map.setFilter('peak', ['in', `,${viewKey},`, ['get', 'views']]); };
    map.on('styledata', applyPeaks);

    // 快速視角按鈕：外框用 fitBounds（自動依畫面寬度決定縮放），全島回到初始中心
    document.querySelector(`.map-views[data-for="${el.id}"]`)?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('button'); if (!btn) return;
      const v = JSON.parse(btn.dataset.view!);
      viewKey = v.key; applyPeaks();
      btn.parentElement!.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      const motion = { pitch: v.pitch, bearing: v.bearing, duration: matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 1600, essential: true };
      if (v.bounds) map.fitBounds([[v.bounds[0], v.bounds[1]], [v.bounds[2], v.bounds[3]]], { ...motion, padding: NARROW ? 16 : 48 });
      else map.flyTo({ ...motion, center: v.center, zoom: v.zoom - (NARROW ? 0.6 : 0) });
    });
    // 經典路線：高亮所選路線並飛過去，其他路線淡化；選回空白即復原
    document.querySelector(`.map-views[data-for="${el.id}"] select`)?.addEventListener('change', (e) => {
      const sel = e.target as HTMLSelectElement, id = sel.value;
      const opt = sel.selectedOptions[0];
      for (const src of ['routesGov', 'routesOsm']) {
        if (!map.getLayer(`${src}-hl`)) continue;
        for (const l of [`${src}-hl`, `${src}-hl-casing`]) map.setFilter(l, ['all', ['==', ['get', 'kind'], 'route'], ['==', ['get', 'trail_id'], id || '__none__']]);
        map.setFilter(`${src}-flow`, ['all', ['==', ['get', 'kind'], 'flow'], ['==', ['get', 'trail_id'], id || '__none__']]);
        for (const l of [`${src}-route`, `${src}-access`]) map.setPaintProperty(l, 'line-opacity', id ? 0.35 : 1);
      }
      document.querySelectorAll<HTMLElement>(`.classic-card[data-for="${el.id}"]`).forEach((c) => { c.hidden = c.dataset.trail !== id; });
      if (!id) return;
      document.querySelectorAll(`.map-views[data-for="${el.id}"] button`).forEach((b) => b.setAttribute('aria-pressed', 'false'));
      const bb = JSON.parse(opt.dataset.bb!);
      // 桌機的介紹卡疊在地圖左側，左邊留出卡片寬度，路線才不會被蓋住
      map.fitBounds([[bb[0], bb[1]], [bb[2], bb[3]]], { padding: NARROW ? 24 : { top: 64, bottom: 64, right: 72, left: Math.min(380, el.clientWidth * 0.45) }, pitch: 50, bearing: 0, maxZoom: 12.5, duration: matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 1600 });
    });

    // 介紹卡的 × 等同把選單選回空白
    document.querySelectorAll<HTMLElement>(`.classic-card[data-for="${el.id}"] .classic-close`).forEach((b) => b.addEventListener('click', () => {
      const sel = document.querySelector<HTMLSelectElement>(`.map-views[data-for="${el.id}"] select`);
      if (sel) { sel.value = ''; sel.dispatchEvent(new Event('change')); }
    }));

    // 使用者自己拖曳後，按鈕不再顯示為選取中
    map.on('dragstart', () => document.querySelectorAll(`.map-views[data-for="${el.id}"] button`).forEach((b) => b.setAttribute('aria-pressed', 'false')));

    // 路線、接駁道路、登山口：只顯示名稱與來源，不進詳頁
    const lineHtml = (p: any) =>
      p.address ? `<b>${p.name}</b><br>${p.address}${p.website ? `<br><a href="${p.website}" target="_blank" rel="noopener">官方網站 →</a>` : ''}`
      : p.kind === 'trailhead' ? `<b>${p.name}</b><br><span style="color:#6E6B64">${p.trail}</span>`
      : p.kind === 'access' ? `<b>${p.name}聯外道路</b><br>${p.via || '—'}・約 ${p.length_km} km<br><span style="color:#6E6B64">OSM 道路路網計算，車行限制以公告為準</span>`
      : `<b>${p.trail}</b>${p.category === '經典縱走' ? '・經典縱走' : ''}${p.trail_en ? `<br><span style="color:#6E6B64">${p.trail_en}</span>` : ''}<br><span style="color:#6E6B64">${p.source}</span>`;
    const linePopup = new maplibregl.Popup({ closeButton: TOUCH, closeOnClick: TOUCH, offset: 8, maxWidth: '280px' });
    for (const layer of ['routesGov-route', 'routesOsm-route', 'routesOsm-access', 'trailhead', 'hq']) {
      if (TOUCH) {
        map.on('click', layer, (e) => { if (!map.queryRenderedFeatures(e.point, { layers: ['hut-hit'] }).length) linePopup.setLngLat(e.lngLat).setHTML(lineHtml(e.features![0].properties)).addTo(map); });
      } else {
        map.on('mousemove', layer, (e) => {
          if (map.queryRenderedFeatures(e.point, { layers: ['hut-hit'] }).length) { linePopup.remove(); return; } // 山屋優先
          map.getCanvas().style.cursor = 'help'; linePopup.setLngLat(e.lngLat).setHTML(lineHtml(e.features![0].properties)).addTo(map); });
        map.on('mouseleave', layer, () => { map.getCanvas().style.cursor = ''; linePopup.remove(); });
      }
    }
  }
</script>
