# Notion 內部整合 token（Settings → Connections → Develop or manage integrations）
# 需將六個資料庫分享給此整合。切勿提交到版控。
NOTION_TOKEN=secret_xxx

# 六庫 data source ID（collection:// 後面那段）
NOTION_DS_HUTS=3922580d-8bb6-4a2e-b42c-1e0cc0010b07
NOTION_DS_EVENTS=ae37d509-a3d8-4488-bec6-a707a1f57ab5
NOTION_DS_SOURCES=a384b25f-9a95-4e16-9f3d-d52a5dbba902
NOTION_DS_AGENCIES=88131947-e1ee-4b24-bc75-1b81f8dbe6bf
NOTION_DS_TRAILS=c68bfe5f-ea67-4da7-b968-9162cb35faa7
NOTION_DS_PHOTOS=9ca5a932-5092-45eb-a048-506e748a3ee0

# 網站輸出模式：published（只輸出「已覆核」，正式站預設）／draft（含「AI 初稿待覆核」，開發預覽）
PUBLISH_MODE=draft

# GitHub Pages 路徑（專案站填 /<repo>/）
SITE_URL=https://example.github.io
BASE_PATH=/
