[
 {
  "id": "3f6bf2d8-5a3b-8113-9e16-ff1eb9d8858f",
  "name": "能高安東軍縱走",
  "en": "Nenggao–Andongjun Traverse",
  "system": "其他",
  "code": null,
  "gis": "OSM r14522297",
  "notes": "AI 初稿，待覆核。沿線營地（白石池、萬里池等）尚未建檔。",
  "category": "經典縱走",
  "summary": "從天池山莊往南沿中央山脈主稜，經能高山主峰、能高南峰、光頭山、白石山到安東軍山。沿途有白石池、萬里池、屯鹿池等高山湖泊，尾段多往奧萬大方向下山。"
 },
 {
  "id": "3f6bf2d8-5a3b-811a-822f-c24ea4de2ec1",
  "name": "丹大東郡橫斷（南三段）",
  "en": "Danda–Dongjun Traverse",
  "system": "其他",
  "code": null,
  "gis": "OSM r18300514",
  "notes": "AI 初稿，待覆核。岳界通稱南三段，狹義為丹大山至無雙山（百岳 6 座）；廣義「大南三段」含七彩湖至丹大山主稜。來源：健行筆記、維基百科「中央山脈大縱走」（查證 2026-10-11，非官方定義）。沿線山屋與營地尚未建檔。",
  "category": "經典縱走",
  "summary": "岳界通稱南三段，狹義指丹大山到無雙山，經內嶺爾山、馬路巴拉讓山、東郡大山等，含六座百岳；廣義的「大南三段」另加七彩湖到丹大山的主稜。位在中央山脈最偏遠的山區，沿線沒有避難山屋。"
 },
 {
  "id": "3f6bf2d8-5a3b-8161-b170-db63032089fd",
  "name": "聖稜線 O 型縱走",
  "en": "Holy Ridge O-Loop",
  "system": "雪霸國家公園",
  "code": null,
  "gis": "組合：雪霸國家公園登山步道路線圖 雪東線＋聖陵線＋武陵四秀；去除聖陵線圖層中往觀霧／九九山莊的大霸線進出段",
  "notes": "AI 初稿，待覆核。武陵經雪山、聖稜線至大霸，再經品田、池有、桃山回武陵；組成待有走過的同仁確認。",
  "category": "經典縱走",
  "summary": "從武陵出發，經雪山主峰、北稜角沿雪山山脈主稜北行到大霸尖山，再由霸南、新達山屋經品田山、池有山、桃山回到武陵，繞成一圈。主稜段大多在三千公尺以上，素密達斷崖一帶岩層破碎。"
 },
 {
  "id": "3f6bf2d8-5a3b-8185-89ec-fc0b14b3c9b6",
  "name": "玉山後四峰",
  "en": "Yushan Rear Four Peaks",
  "system": "玉山國家公園",
  "code": null,
  "gis": "OSM r18232409",
  "notes": "AI 初稿，待覆核。",
  "category": "經典縱走",
  "summary": "由排雲山莊出發，往南依序登玉山南峰、東小南山、鹿山、南玉山，四座都是百岳。玉山南峰一帶是陡峻的碎石坡，往南玉山的路跡較不明顯。"
 },
 {
  "id": "3f6bf2d8-5a3b-8194-b8d9-eed2f6a093ec",
  "name": "干卓萬群峰",
  "en": "Ganzhuowan Peaks",
  "system": "其他",
  "code": null,
  "gis": "OSM r19930450",
  "notes": "AI 初稿，待覆核。沿線山屋與營地尚未建檔。",
  "category": "經典縱走",
  "summary": "包含卓社大山、牧山、火山、干卓萬山四座百岳，位在南投縣仁愛鄉與信義鄉交界的干卓萬山塊。岳界把它和馬博橫斷、奇萊東稜、南三段並列為百岳的「四大障礙」。"
 },
 {
  "id": "3f6bf2d8-5a3b-81cf-a750-fc88fe147265",
  "name": "新康橫斷",
  "en": "Xinkang Traverse",
  "system": "玉山國家公園",
  "code": null,
  "gis": "OSM 步道路網串接（向陽－三叉山－新康山－抱崖山屋－山風）",
  "notes": "AI 初稿，待覆核。路線組成（向陽－三叉山－新康山－抱崖－八通關越嶺道東段下山）已經使用者確認（2026-10-11）；新康山屋尚未建檔。",
  "category": "經典縱走",
  "summary": "由南橫向陽出發，經嘉明湖、三叉山往東走到新康山，再下抱崖山屋，接八通關越嶺道東段到南安。新康山獨立在中央山脈主稜東側，是花蓮南部的百岳。"
 },
 {
  "id": "3f6bf2d8-5a3b-81ea-9f33-d8fe7e123ba4",
  "name": "奇萊南華",
  "en": "Qilai South Peak & Nanhua",
  "system": "其他",
  "code": null,
  "gis": "OSM r9296111",
  "notes": "AI 初稿，待覆核。屯原登山口經能高越嶺道西段至天池山莊，再上奇萊南峰、南華山。",
  "category": "經典縱走",
  "summary": "由屯原登山口沿能高越嶺道西段上行到天池山莊，再分別登奇萊南峰與南華山。前段是日治時期開鑑的越嶺道，坡度和緩；天池山莊以上是開闊的箭竹草原。"
 },
